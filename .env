# Committed on purpose — see .gitignore for the reasoning.
# These are public values that ship in the built JS regardless. RLS protects
# the data, not key secrecy. Real secrets never live in this file.
#
# To point a local checkout at a different project without editing this file,
# put overrides in .env.local (gitignored).

VITE_SUPABASE_URL=https://qgnxppzchqwpwerajhlu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_AQAtj2_LeFBzgTcGX7ibkQ_AbRxrUJt

# Playing a friend. On, as of the change that shipped the UI — the flag and the
# feature move together so the entry screen's bullets are never a promise.
VITE_ENABLE_MULTIPLAYER=true

# Tournaments. On, in the same change that shipped the bracket UI. Requires
# VITE_ENABLE_MULTIPLAYER too — a bracket slot is played as an mp table.
VITE_ENABLE_TOURNAMENTS=true

# Nemesis, the adaptive solo opponent. ON as of play v16, which is the deploy
# that carries the predictor — the flag and the function move together, because
# open_match defaults `opponent` to 'random' and an app offering the choice
# against an older function would hand players a uniform bot wearing Nemesis's
# name.
VITE_ENABLE_NEMESIS=true
