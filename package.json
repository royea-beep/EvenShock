{
  "name": "evenshock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "themes:separation": "node scripts/theme-separation.mjs",
    "sync:rules": "node scripts/sync-rules.mjs",
    "devnet:setup": "node scripts/devnet/setup.mjs",
    "devnet:e2e": "node scripts/devnet/e2e.mjs",
    "e2e:rounds": "EVENSHOCK_LIVE=1 vitest run --config vitest.live.config.ts",
    "e2e:browser": "node scripts/harness/browser-latency.mjs",
    "e2e:preflight": "node scripts/harness/browser-preflight.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "e2e:entry": "node scripts/harness/entry-door.mjs",
    "status": "node scripts/deploy-status.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.112.2",
    "buffer": "^6.0.3",
    "framer-motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tweetnacl": "^1.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
