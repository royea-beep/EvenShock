# Supabase — leave both blank to run in guest mode with no auth and no
# persistence. When both are set, the wallet connect button appears and
# authenticated matches persist to the schema defined in supabase/migrations/.
#
# Get these from the Supabase project's API settings (project ref is in
# supabase/README.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fast mode (501ms reveal) is FROZEN — three measurements put its p95 over
# budget on desktop, and desktop is the best case. Set to true only to measure
# it; see src/constants/features.ts.
VITE_ENABLE_FAST_MODE=

# Tournaments (chips-only entry fees, single-elimination brackets). Requires
# VITE_ENABLE_MULTIPLAYER — a bracket slot is played as an ordinary mp table.
# NOT related to stake tables: every table a tournament creates is stake zero.
VITE_ENABLE_TOURNAMENTS=

# Nemesis, the adaptive solo opponent. Requires the `play` Edge Function that
# carries the predictor — see src/constants/features.ts for why the ordering
# matters.
VITE_ENABLE_NEMESIS=
